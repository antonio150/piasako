{% extends 'base.html.twig' %}

{% block title %}Administration - Client
{% endblock %}

{% block body %}
	{{ form_start(form) }}
	<div class="row mt-4">
		<div class="col-xl-12">
			<div class="card ">
				<div class="card-header" style="border-bottom: none">
					<div class="row align-items-center mt-2">
						<div class="col-md-4">
							<div class="d-flex align-items-center justify-content-start gap-3">
								<h3 class="mb-0">Client</h3>
							</div>
						</div>
						<div class="col-md-8">
							<div class="d-flex align-items-center justify-content-end gap-3">
								<div class="form-check form-switch">
									{{ form_widget(form.estActif, {
										'label' : false,
										'attr': {
											'class': 'form-check-input bg-warning border border-warning',
											'role': 'switch'
										}
									}) }}
									<label class="form-check-label" for="{{ form.estActif.vars.id }}" id="estActifLabel">
										{% if form.estActif.vars.data %}
											Actif
										{% else %}
											Inactif
										{% endif %}
									</label>
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="card-body">
					
					<div class="row mt-3">
						
						<div class="col-12 col-md-6 col-sm-4 mt-3 mt-sm-0">
							{{ form_label(form.email, 'Email <span class="custom-text-span">*</span>', {
								'label_html': true
							}) }}

							{{ form_widget(form.email, {
								'attr': {
									'class': 'form-control custom-form-control' ~ (form.email.vars.errors|length > 0 ? ' is-invalid' : '')
								}
							}) }}

							{% if form.email.vars.errors|length > 0 %}
								<div class="invalid-feedback d-block">
									{% for error in form.email.vars.errors %}
										{{ error.message }}
									{% endfor %}
								</div>
							{% endif %}
						</div>
					</div>

					<div class="row mt-3">
						
						<div class="col-12 col-md-6 col-sm-4 mt-3 mt-sm-0">
							{{ form_label(form.password, (type is defined and type == 'new') ? 'Mot de passe <span class="custom-text-span">*</span>' : 'Mot de passe', {
								'label_html': true
							}) }}

							{{ form_widget(form.password, {
								'attr': {
									'class': 'form-control custom-form-control' ~ (form.password.vars.errors|length > 0 ? ' is-invalid' : '')
								}
							}) }}

							{% if form.password.vars.errors|length > 0 %}
								<div class="invalid-feedback d-block">
									{% for error in form.password.vars.errors %}
										{{ error.message }}
									{% endfor %}
								</div>
							{% endif %}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="row">
		<div class="col-12">
			<div class="d-flex justify-content-end align-items-center gap-3 mb-4">
				{% if type is defined and type == 'edit' %}
                    <div>
                        <a href="javascript:history.back()" class="btn btn-success btn-wave">Annuler</a>
    				</div>
                {% endif %}
				<div>
					<button type="submit" class="btn btn-warning btn-wave _btn_submit">Valider</button>
				</div>
			</div>
		</div>
	</div>
	{{ form_end(form) }}
{% endblock %}

{% block block_js %}
    {% include('script/_form.html.twig') %}
{% endblock %}
