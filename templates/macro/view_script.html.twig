{% macro scriptBtnAdd(role) %}
    {% if not is_granted(role) %}
        <script>
            setTimeout(function() {
                const buttons = document.querySelectorAll('._btn_insert');

                // Ajouter l'attribut 'disabled' à chaque bouton
                buttons.forEach(button => {
                    button.classList.add('d-none');
                });
            }, 1000)
        </script>
    {% endif %}
{% endmacro %}