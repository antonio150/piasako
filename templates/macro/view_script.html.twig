{% macro scriptModeView(role) %}
    {% if app.request.query.get('view') or not is_granted(role) %}
        <script>
            const buttons = document.querySelectorAll('._btn_submit');

            // Ajouter l'attribut 'disabled' à chaque bouton
            buttons.forEach(button => {
                button.setAttribute('disabled', 'true');
            });
        </script>
    {% endif %}
{% endmacro %}

{% macro scriptModeSortie(role) %}
    {% if  not is_granted(role) %}
        <script>
            setTimeout(function() {
            const buttons = document.querySelectorAll('._btn_sortie');

            // Ajouter l'attribut 'disabled' à chaque bouton
            buttons.forEach(button => {
                button.setAttribute('disabled', 'true');
            });
            }, 1000)
        </script>
    {% endif %}
{% endmacro %}

