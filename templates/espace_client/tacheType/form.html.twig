{% extends 'base_dynamic.html.twig' %}

{% import "components/_informations.html.twig" as macros_information %}

{% block title %}
    {{ isView ? 'Voir Taches' : (taches.id ? 'Modifier Tache' : 'Nouveau Tache') }}
{% endblock %}

{% block block_css %}
    <style>
        .custom-form-control {
            height: 38.39px;
            appearance: auto !important;
        }
        /* --- styles pour la liste des jours --- */
        .weekday-list {
            display: flex;
            gap: 8px;
            flex-wrap: nowrap;
            align-items: center;
        }
        .weekday-item {
            padding: 6px 10px;
            border-radius: 6px;
            border: 1px solid #ced4da;
            background: #fff;
            color: #212529;
            cursor: pointer;
            user-select: none;
            font-size: 0.92rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 70px;
            text-align: center;
        }
        .weekday-item:focus {
            outline: 2px solid rgba(13,110,253,0.25);
            outline-offset: 2px;
        }
        .weekday-item.selected {
            background-color: #0d6efd; /* bootstrap primary */
            color: #fff;
            border-color: #0d6efd;
        }
        /* si l'affichage est restreint, autoriser wrapping */
        @media (max-width: 420px) {
            .weekday-list { flex-wrap: wrap; gap:6px; }
            .weekday-item { min-width: 60px; font-size:0.85rem; padding:5px 8px; }
        }
    </style>

{% endblock %}

{% block body %}
    {{ form_start(form) }}
    <div class="row mt-4">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-header" style="border-bottom: none">
                    <div class="row align-items-center mt-2">
                        <div class="col-md-4">
                            <div class="d-flex align-items-center justify-content-start gap-3">
                                <h3 class="mb-0">Tache Type</h3>
                              
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row">
                            <div class="col-12">
                                <div class="row">
                                    <div class="col-md-12 mb-3">
                                        {{ form_label(form.ttpLibelle, 'Libelle', {'label_attr': {'class': 'mb-2'}}) }}
                                        {{ form_widget(form.ttpLibelle, {'attr': {'class': 'form-control custom-form-control', 'disabled': isView ? true : false}}) }}
                                        {{ form_errors(form.ttpLibelle) }}
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        {{ form_label(form.ttpCouleur, 'Couleur', {'label_attr': {'class': 'mb-2'}}) }}
                                        {{ form_widget(form.ttpCouleur, {
                                            attr: {
                                                class: ' form-control-color',
                                                type: 'color',
                                                disabled: isView ? true : false
                                            }
                                        }) }}
                                        {{ form_errors(form.ttpCouleur) }}
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <div class="form-check mt-4">
                                            {{ form_widget(form.ttpcomptabiliser, {
                                                'attr': {
                                                    'class': 'form-check-input',
                                                    'disabled': isView ? true : false
                                                }
                                            }) }}
                                            {{ form_label(form.ttpcomptabiliser, 'Comptabiliser', {'label_attr': {'class': 'form-check-label'}}) }}
                                        </div>
                                        {{ form_errors(form.ttpcomptabiliser) }}
                                    </div>

                                    <div class="col-md-3 mb-3">
                                        <div class="form-check mt-4">
                                            {{ form_widget(form.ttpplanifiable, {
                                                'attr': {
                                                    'class': 'form-check-input',
                                                    'disabled': isView ? true : false
                                                }
                                            }) }}
                                            {{ form_label(form.ttpplanifiable, 'Planifiable', {'label_attr': {'class': 'form-check-label'}}) }}
                                        </div>
                                        {{ form_errors(form.ttpplanifiable) }}
                                    </div>
                                </div>
                                <div class="row">
                                    
                                    <div class="col-md-6 mb-3">
                                        {{ form_label(form.ttpNbTravailleurRequis, 'Nombre Travailleur', {'label_attr': {'class': 'mb-2'}}) }}
                                        {{ form_widget(form.ttpNbTravailleurRequis, {'attr': {'class': 'form-control custom-form-control', 'disabled': isView ? true : false}}) }}
                                        {{ form_errors(form.ttpNbTravailleurRequis) }}
                                    </div>
                                </div>
                                
                            </div>
                            
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-end align-items-center gap-3 mb-4">
                <div>
                    <a href="{{ path('app_tache_index') }}" class="btn btn-warning btn-wave">Annuler</a>
                </div>
                <div>
                    <button type="submit" {% if isView %}disabled{% endif %} class="btn btn-primary btn-wave _btn_submit">Valider</button>
                </div>
            </div>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}

{% block block_js %}
    
  
{% endblock %}
