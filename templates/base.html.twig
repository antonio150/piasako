{# CONVERT DATE VERS HEURE LOCAL CLIENT #}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Fonction pour formater une date au format "dd/mm/yyyy" et une heure au format "hh:ii"
        function formatDateAndTime(dateString) {
            const date = new Date(dateString);
            const optionsDate = {day: '2-digit', month: '2-digit', year: 'numeric'};
            const optionsTime = {hour: '2-digit', minute: '2-digit', hour12: false};

            const formattedDate = date.toLocaleDateString('fr-FR', optionsDate);
            const formattedTime = date.toLocaleTimeString('fr-FR', optionsTime);

            return {formattedDate, formattedTime};
        }

        // Parcours de toutes les spans avec la classe "_convert_date"
        const dateElements = document.querySelectorAll('span._convert_date');
        dateElements.forEach(span => {
            const dateString = span.textContent.trim(); // Récupère la date au format 'c' de Twig
            const {formattedDate} = formatDateAndTime(dateString);
            span.textContent = formattedDate; // Met à jour le texte avec la date formatée
        });

        // Parcours de toutes les spans avec la classe "_convert_time"
        const timeElements = document.querySelectorAll('span._convert_time');
        timeElements.forEach(span => {
            const dateString = span.textContent.trim(); // Récupère la date au format 'c' de Twig
            const {formattedTime} = formatDateAndTime(dateString);
            span.textContent = formattedTime; // Met à jour le texte avec l'heure formatée
        });
    });
</script>

