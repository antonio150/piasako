<script>
    document.addEventListener("DOMContentLoaded", function () {
        const tooltipInformations = document.querySelectorAll('#tooltipInformations');
        tooltipInformations.forEach(tooltipTriggerEl => {
            const contentId = tooltipTriggerEl.getAttribute("data-bs-title");
            const tooltipContent = document.getElementById(contentId)?.innerHTML || "Aucune information";

            new bootstrap.Tooltip(tooltipTriggerEl, {
                title: tooltipContent,
                html: true,
                sanitize: false,
                placement: "bottom",
                customClass: "custom-tooltip",
                popperConfig: {
                    modifiers: [
                        {
                            name: 'preventOverflow',
                            options: {
                                boundary: 'viewport',
                            },
                        },
                        {
                            name: 'offset',
                            options: {
                                offset: [200, 2]
                            }
                        }
                    ]
                }

            });
        });
    });
</script>

<!-- AJUSTER LA TAILLES DE LA TEXTAREA -->
<script>
    function adjustTextareaHeight(textarea) {

        let heightTextArea = textarea.scrollHeight;
        textarea.style.height = '40px';
        textarea.style.minHeight = '40px';

        if (!textarea.value) return;

        textarea.style.overflowY = 'hidden';

        // Cas d'une seule ligne
        if (heightTextArea < 56 && heightTextArea > 38) {
            return;
        }

        // Cas de deux lignes
        if (heightTextArea < 78 && heightTextArea > 56) {
            heightTextArea = 56;
        }

        // Appliquer la logique d'incrémentation de 22 à partir de 78
        if (heightTextArea >= 78) {
            heightTextArea = 78 + Math.floor((heightTextArea - 78) / 22) * 22;
        }

        if (heightTextArea > 40) textarea.style.minHeight = heightTextArea + 'px';
    }

    document.addEventListener('DOMContentLoaded', function () {
        const textareas = document.querySelectorAll('.form-textarea-control');
        const send_email_remarqueInput = document.querySelector('#send_email_remarque');

        // Add modal show event listener
        const modal = document.querySelector('.modalAyantTextarea'); // adjust selector to match your modal
        if (modal) {
            modal.addEventListener('shown.bs.modal', function () {
                // Get textareas only inside this specific modal
                const modalTextareas = modal.querySelectorAll('.form-textarea-control');

                modalTextareas.forEach(textarea => {
                    textarea.style.height = 'auto';
                    adjustTextareaHeight(textarea);
                });
            });
        }

        textareas.forEach(textarea => {
            // Initial adjustment with setTimeout
            adjustTextareaHeight(textarea);

            textarea.addEventListener('input', function () {
                adjustTextareaHeight(this);
            });
        });
    });
</script>

<!-- =============== PLACEHOLDER DES CHAMP TYPE DATE TRANSPARENT ============== -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const dateInputs = document.querySelectorAll('input[type="date"]');

        dateInputs.forEach(input => {
            // Ajout d'une classe CSS personnalisée
            input.classList.add('date-input-custom');

            input.addEventListener('input', function () {
                if (this.value) {
                    this.classList.remove('empty');
                } else {
                    this.classList.add('empty');
                }
            });

            input.addEventListener('keyup', function () {
                this.classList.remove('empty');
            })

            // Initialisation de l'état
            if (!input.value) {
                input.classList.add('empty');
            }
        });
    });
</script>

<script>
    // Masquer les messages flash après 3 secondes (3000 ms)
    setTimeout(() => {
        const flashMessages = document.querySelectorAll('.flash-message');
        flashMessages.forEach(el => {
            el.style.transition = "opacity 0.5s ease-out";
            el.style.opacity = 0;

            // Supprimer complètement après le fondu
            setTimeout(() => el.remove(), 500);
        });
    }, 3000);
</script>

{% if is_granted("ROLE_SUPER_ADMIN") %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Récupérer le chemin actuel
            const currentPath = window.location.pathname;

            // Sélectionner tous les éléments li.slide
            const menuItems = document.querySelectorAll('.main-menu ul li.slide');

            // Retirer toutes les classes active et open
            menuItems.forEach(function (item) {
                item.classList.remove('open', 'active');
                const link = item.querySelector('a');
                if (link) {
                    link.classList.remove('active');
                }
            });

            // Vérifier si nous sommes sur la page d'édition d'un client
            const isClientEditPage = currentPath.includes('/super-admin/client/') && currentPath.includes('/edit');

            // Ajouter les classes aux éléments correspondants
            menuItems.forEach(function (item) {
                const link = item.querySelector('a');
                if (link) {
                    const href = link.getAttribute('href');

                    // Si le lien correspond exactement au chemin actuel
                    if (href === currentPath) {
                        item.classList.add('open', 'active');
                        link.classList.add('active');
                    }
                    // Si nous sommes sur la page d'édition et que c'est le lien "Client"
                    else if (isClientEditPage && href === '/super-admin/client') {
                        item.classList.add('open', 'active');
                        link.classList.add('active');
                    }
                }
            });
        });

    </script>
{% endif %}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.32/dist/sweetalert2.all.min.js"></script>

{% for label, messages in app.flashes %}
    {% for message in messages %}
        {% set _titreAlert = "Confirmation" %}

        {% if label == "error" %}
            {% set _titreAlert = "Erreur" %}
        {% endif %}

        <script>
            //----------------------------------MESSAGE FLASH --------------------------------------
            window.addEventListener('load', function() {
                Swal.fire({
                    icon: '{{ label }}',  // Icône d'erreur
                    title: '<span style="font-size: 11px !important;">{{ _titreAlert }}</span>',
                    text: "{{ message|nl2br }}",  // Texte d'erreur
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 5000,
                    timerProgressBar: true
                });
            });
        </script>
    {% endfor %}
{% endfor %}

