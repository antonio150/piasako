        .date-input-custom::-webkit-calendar-picker-indicator {
            opacity: 1;
        }

        .date-input-custom::-moz-calendar-picker-indicator {
            opacity: 1;
        }

        /* =============== LARGEUR MENU SUR MAIN-SEDEBAR ============== */
        .custom-height-menu-sidebar {
            height: 38px !important;
        }

        /* ============================================================ */

        /* ================ SELECT2 =============== */

        .select-with-icon {
            position: relative;
        }

