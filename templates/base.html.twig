        }

        .color-background {
            background: linear-gradient(to bottom, rgba(243, 149, 17, 0.49) 0px, var(--custom-white) 200px);
        }

        .btn-fixed-width {
            width: 169px;
            text-align: center;
            display: flex; /* Utiliser flexbox */
            align-items: center; /* Centrer verticalement */
            justify-content: center; /* Centrer horizontalement */
            padding: 0.375rem 0.75rem; /* Padding uniforme pour l'apparence */
            line-height: 1.5; /* Hauteur de ligne pour éviter les décalages */
            height: 38px; /* Hauteur fixe pour aligner avec les autres éléments */
            box-sizing: border-box; /* Inclure padding dans la largeur/hauteur */
