{# SCRIPT ACTIVE MENU #}
<script>
    // Récupérer l'URL actuelle
    const currentUrl = window.location.pathname;

    // Sélectionner tous les liens du menu
    const menuItems = document.querySelectorAll("a.side-menu__item");

    // Parcourir tous les liens
    menuItems.forEach(item => {
        // Vérifier si l'URL de l'attribut href est incluse dans l'URL actuelle
        if (currentUrl.includes(item.getAttribute("href"))) {
            // Ajouter la classe 'active' au lien correspondant
            item.classList.add("active");

            // Récupérer le parent (menu) si présent
            const parentSlide = item.closest(".has-sub");
            if (parentSlide) {
                // Ajouter les classes nécessaires au parent
                parentSlide.classList.add("open", "active");

                // Assurer que le sous-menu est visible
                const subMenu = parentSlide.querySelector(".slide-menu");
                if (subMenu) {
                    subMenu.style.display = "block"; // Forcer l'affichage du sous-menu
                }
            }
        }
    });
</script>

<script>
